# Copy to .env and fill in. .env is listed in .gitignore. Never commit it.
# Local scripts read this file. Deployed Lambdas read secrets from SSM Parameter Store,
# which scripts/put-secrets.sh fills from this file.

# --- Flagsmith -------------------------------------------------------------------------
# Organisation API key: Organisation settings -> API Access -> Create API Key.
FLAGSMITH_ADMIN_API_KEY=
# Numeric project ID. It is in the dashboard URL: app.flagsmith.com/project/<ID>/...
FLAGSMITH_PROJECT_ID=
# The environment's key (the client-side key shown under Environment -> SDK Keys).
FLAGSMITH_ENVIRONMENT_KEY=
# Server-side key for the same environment (starts with "ser.").
# Create it under Environment -> SDK Keys -> Server-side Environment Keys.
FLAGSMITH_SERVER_KEY=
# Only for self-hosted Flagsmith. Default is https://api.flagsmith.com
# FLAGSMITH_API_HOST=
# Required by self-hosted/docker-compose.yml (generate with: openssl rand -hex 32)
# FLAGSMITH_DJANGO_SECRET_KEY=

# --- Slack (Phase 2+) ------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# --- LLM (Phase 4+) ---------------------------------------------------------------------
# Groq API key (starts with gsk_) from console.groq.com. This is the default provider.
GROQ_API_KEY=
# Optional: xAI Grok API key (starts with xai-) from console.x.ai, for LlmProvider=xai.
XAI_API_KEY=
# Without a key, ShedPilot uses its rule-based proposal.
# Optional deploy settings read by scripts/deploy-agent.sh (defaults shown):
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# DRY_RUN=false
# APPROVER_USER_IDS=

# --- Load test -------------------------------------------------------------------------
# Optional. If empty, the load test reads ApiUrl from the "shedpilot" stack outputs.
API_URL=



